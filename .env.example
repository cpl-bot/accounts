# Talai frontend configuration.
# Copy this file to .env (git-ignored; .env.local also works) and fill in real values.

# Base URL of the FastAPI middleware (see middleware/.env.example). The
# Next.js server (app/api/talai/[...path]/route.ts) is the only thing that
# talks to it directly — browser code always goes through /api/talai/*.
MIDDLEWARE_URL=http://localhost:8000

# Bearer token sent as `Authorization: Bearer <key>` to the middleware.
# Must match MIDDLEWARE_API_KEY in middleware/.env — treat it as a secret.
MIDDLEWARE_API_KEY=change-me

# When true, the API proxy serves fixture data from lib/api/demo-fixtures.ts
# instead of forwarding to the middleware, so the UI runs without Tally or
# the middleware present (e.g. for a walkthrough or screenshot). Never set
# this to true in a real deployment — it hides the write path entirely.
NEXT_PUBLIC_DEMO_MODE=false

# Shown in the sidebar and page titles.
NEXT_PUBLIC_APP_NAME=Talai

# `next start` binds to these. HOSTNAME=0.0.0.0 is required to serve the app
# to other machines on the office LAN, not just localhost.
PORT=3000
HOSTNAME=0.0.0.0
