# Talai middleware configuration.
# Copy to middleware/.env and edit. .env is git-ignored; never commit secrets.
# Every variable below is read by talai_middleware/config.py.

# ---------------------------------------------------------------------------
# Tally connection (the TallyPrime Gold server PC on the LAN)
# ---------------------------------------------------------------------------
# IP or hostname of the PC running TallyPrime with the XML/HTTP server enabled.
TALLY_HOST=192.168.1.24
# Tally's XML/HTTP port. 9000 is the default in TallyPrime.
TALLY_PORT=9000
# The company that must be open in Tally. Writes are refused unless the name
# matches exactly. Leave blank until you have run scripts/check_tally_connection.py.
TALLY_COMPANY_NAME=
# Timeout for a normal request (seconds). Imports of large batches need more.
TALLY_TIMEOUT_SECONDS=30
# Timeout for the cheap reachability probe behind GET /tally/status.
TALLY_STATUS_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# SAFETY SWITCH — leave false until dry-run push has been reviewed on the LAN
# ---------------------------------------------------------------------------
# false: push validates drafts and stores the generated XML, sending nothing.
# true:  push sends Import Data requests to Tally (create-only; never Alter/Delete).
TALLY_WRITE_ENABLED=false

# ---------------------------------------------------------------------------
# Middleware
# ---------------------------------------------------------------------------
# Shared bearer token. The Next.js proxy sends it; the browser never sees it.
MIDDLEWARE_API_KEY=change-me
# SQLite for v1. Postgres/Supabase later is a URL change plus `alembic upgrade head`.
DATABASE_URL=sqlite:///./data/talai.db
# Comma-separated origins allowed to call the API directly (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
# Interface and port uvicorn binds. Bind to the LAN interface only.
HOST=0.0.0.0
PORT=8000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Scheduled pull sync
# ---------------------------------------------------------------------------
# false disables the background scheduler entirely (tests set this).
SYNC_ENABLED=true
# Minutes between scheduled pulls.
SYNC_INTERVAL_MINUTES=15
# Local-time window the scheduler runs in, HH:MM-HH:MM.
SYNC_WORKING_HOURS=08:00-20:00
# Days of overlap re-pulled each run, to catch back-dated vouchers.
SYNC_OVERLAP_DAYS=3
# Consecutive failures before the circuit breaker opens.
SYNC_BREAKER_THRESHOLD=3
# Cap on the exponential backoff once the breaker is open (minutes).
SYNC_BREAKER_MAX_BACKOFF_MINUTES=30

# ---------------------------------------------------------------------------
# Push (outbox → Tally); only ever runs on an explicit user action
# ---------------------------------------------------------------------------
# Maximum drafts committed in one POST /sync/push.
PUSH_BATCH_SIZE=10
# Pause between per-draft Import requests, so Tally's UI stays responsive.
PUSH_INTER_REQUEST_DELAY_MS=250
# How many days into the future a voucher date may be. 0 = today at the latest.
MAX_FUTURE_DAYS=0

# ---------------------------------------------------------------------------
# OCR of uploaded bills, through a local LLM (plan §3.10)
# ---------------------------------------------------------------------------
# none:   uploads are stored but never read (default; nothing extra to install).
# mock:   a bundled fixture is returned, so the whole pipeline can be demoed.
# ollama: the real thing — Ollama on this LAN reads the bill. Bills never leave
#         the network.
OCR_PROVIDER=none
# Where Ollama listens. On the Ubuntu server that is usually localhost.
OLLAMA_BASE_URL=http://localhost:11434
# The vision model. Pull it first:  ollama pull gemma3:12b
OLLAMA_MODEL=gemma3:12b
# A 12B vision model on CPU can take minutes for a multi-page bill.
OCR_TIMEOUT_SECONDS=180
# Fields the model is less sure than this about put the draft into review.
OCR_MIN_CONFIDENCE=0.7

# ---------------------------------------------------------------------------
# Audit and uploads
# ---------------------------------------------------------------------------
# true stores the full request/response XML on every audit row. Useful while
# validating on the LAN; it makes the database grow quickly.
AUDIT_STORE_XML=false
# Where uploaded bill files are written (random names; PDF/PNG/JPG only).
UPLOAD_DIR=./data/uploads
# Per-file upload limit in megabytes.
MAX_UPLOAD_MB=20
